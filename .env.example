# ====================================================
# INTERLUDE - Environment Configuration
# ====================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── MongoDB ─────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/interlude

# ── Redis (used for rate limiting, session cache) ───
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Session ──────────────────────────────────────────
SESSION_SECRET=change_me_to_yet_another_long_random_secret

# ── Email / SMTP ─────────────────────────────────────
# Leave blank in development — emails will be logged to console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@interlude.app

# ── Frontend URLs ────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Streaming Provider ───────────────────────────────
# Supported values: internet_archive | self_hosted | licensed
STREAMING_PROVIDER=internet_archive

# Internet Archive (no API key required — public API)
INTERNET_ARCHIVE_API_BASE=https://archive.org

# Self-hosted HLS base URL (used when STREAMING_PROVIDER=self_hosted)
SELF_HOSTED_HLS_BASE_URL=

# ── Cloudinary (Avatar & Image Uploads) ─────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── WebRTC / TURN Server ─────────────────────────────
# In development, STUN-only is used automatically if TURN is not configured
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=

# ── FFmpeg ───────────────────────────────────────────
# Path to ffmpeg binary (used for HLS transcoding if self-hosted)
# Leave blank to use system PATH
FFMPEG_PATH=

# ── Sentry (Error Tracking) ──────────────────────────
SENTRY_DSN=

# ── Admin Bootstrap ──────────────────────────────────
# Email of the first admin user (created by seed script)
ADMIN_EMAIL=admin@interlude.app
ADMIN_PASSWORD=change_me_in_production

# ── CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
